{
  "manifest_version": 3,
  "name": "Sparrow Focus",
  "version": "0.1.0",
  "description": "Blocks the sites you choose during your Sparrow focus sessions.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Sparrow Focus" },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["blocked.html", "blocked.js", "ui.css"], "matches": ["<all_urls>"] }
  ],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
