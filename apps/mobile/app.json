{
  "expo": {
    "name": "Sparrow",
    "slug": "sparrow",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["android"],
    "android": {
      "package": "com.sparrow.app",
      "blockedPermissions": ["android.permission.READ_EXTERNAL_STORAGE", "android.permission.RECORD_AUDIO"],
      "allowBackup": false
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Sparrow uses the camera only when you take a photo as proof.",
          "microphonePermission": false,
          "photosPermission": false
        }
      ]
    ]
  }
}
