{
  "name": "sparrow",
  "private": true,
  "workspaces": ["apps/web", "packages/shared"],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "typecheck": "npm run typecheck -w packages/shared && npm run typecheck -w apps/web",
    "test": "npm run test -w packages/shared",
    "test:extension": "node --test apps/extension/tests/*.test.js"
  }
}
